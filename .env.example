# CampusOS — Variabel Lingkungan
#
# Salin file ini menjadi `.env.local` dan isi dengan nilai dari proyek
# Supabase-mu (Dashboard Supabase → Settings → API).
# JANGAN commit file `.env.local` — file itu sudah masuk .gitignore.

# URL proyek Supabase, mis. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci anon (publishable) Supabase — aman dipakai di browser karena
# akses data dibatasi Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
